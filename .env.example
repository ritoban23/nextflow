# Neon PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Clerk auth keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_or_pk_live_xxx"
CLERK_SECRET_KEY="sk_test_or_sk_live_xxx"

# Trigger.dev project credentials
TRIGGER_SECRET_KEY="tr_dev_or_tr_prod_xxx"
TRIGGER_PROJECT_ID="proj_xxx"

# Optional base URL used by internal server callbacks (defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transloadit credentials
TRANSLOADIT_AUTH_KEY="your_transloadit_auth_key"
TRANSLOADIT_AUTH_SECRET="your_transloadit_auth_secret"
NEXT_PUBLIC_TRANSLOADIT_AUTH_KEY="your_transloadit_auth_key"

# Google AI Studio key for Gemini
GEMINI_API_KEY="your_gemini_api_key"
